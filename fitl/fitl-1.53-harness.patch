diff --git a/src/main/scala/fitl/AirLiftBench.scala b/src/main/scala/fitl/AirLiftBench.scala
new file mode 100644
index 0000000..d5c5205
--- /dev/null
+++ b/src/main/scala/fitl/AirLiftBench.scala
@@ -0,0 +1,121 @@
+//  AirLiftBench: why does a US Air Lift trial cost what it costs?
+//  Part of the Claude-FitL harness; not in the upstream program.
+//
+//  Usage: java -cp "fitl/lib/*" fitl.AirLiftBench --policy P.json [--us-player]
+//                [--seed 1] [--games 10] [--boards 300] [--reps 25] [--warmup 20]
+//
+//  1. Plays games with the US search policy and records the board at each US
+//     decision (up to --boards boards).
+//  2. Replays the US Bot's Air Lift (as the Special Activity of a Train, on the
+//     board before the Operation) on every recorded board: --warmup rounds to
+//     let the JIT compile, then --reps timed runs per board (median kept).
+//     Boards whose Air Lift runs into the program's endless loop are dropped.
+//  3. Runs each board once more with the Prof counters and phase timers on,
+//     and measures the bytes allocated.
+//  Prints the per-Air-Lift budget: how often each piece of work happens and
+//  what it costs, and how cost grows with the destinations tried.
+
+package fitl
+
+import scala.util.Random
+import FireInTheLake._
+import Bot._
+
+object AirLiftBench {
+  var recording = false
+  var maxBoards = 300
+  val boards = scala.collection.mutable.ArrayBuffer.empty[GameState]
+
+  def record(g: GameState): Unit = if (recording && boards.size < maxBoards) boards += g
+
+  val moveTypes = (USTroops::ARVNTroops::Irregulars:::Rangers).toSet[PieceType]
+
+  //  One Air Lift on board `b`, undone afterwards. True if it moved anything.
+  def airLift(b: GameState): Boolean = {
+    game = b
+    Random.setSeed(12345L)
+    initTurnVariables()
+    workLeft = USPolicy.DefaultTrialWork
+    try testOutcome { US_Bot.airLiftActivity(Params(addSpecialActivity = true)) }
+    finally { workLeft = Long.MaxValue; game = b }
+  }
+
+  def main(args: Array[String]): Unit = {
+    def arg(name: String, default: String) = {
+      val i = args.indexOf(name)
+      if (i >= 0 && i + 1 < args.length) args(i + 1) else default
+    }
+    val seed   = arg("--seed", "1").toLong
+    val games  = arg("--games", "10").toInt
+    val reps   = arg("--reps", "25").toInt
+    val warmup = arg("--warmup", "20").toInt
+    maxBoards  = arg("--boards", "300").toInt
+    USPolicy.load(arg("--policy", "policies/tune3-start.json"))
+    if (args.contains("--us-player")) { usIsPlayer = true; arvnTracked = true }
+
+    // 1. Record boards
+    recording = true
+    var g = 0
+    while (g < games && boards.size < maxBoards) { Autoplay.runGame(seed + g, usFinalOnly = true); g += 1 }
+    recording = false
+
+    // Drop boards caught in the endless Air Lift loop
+    val ok = boards.toVector filter { b => try { airLift(b); true } catch { case _: Throwable => false } }
+    val effective = ok count airLift
+
+    // 2. Warm up, then time
+    for (_ <- 1 to warmup; b <- ok) airLift(b)
+    val medians = ok map { b =>
+      val ts = (1 to reps).map { _ => val t0 = System.nanoTime; airLift(b); System.nanoTime - t0 }.sorted
+      ts(ts.size / 2) / 1000.0
+    }
+
+    // 3. Instrumented pass, per board, plus allocation
+    val mx = java.lang.management.ManagementFactory.getThreadMXBean.asInstanceOf[com.sun.management.ThreadMXBean]
+    val tid = Thread.currentThread.getId
+    case class PerBoard(dests: Long, served: Long, liftable: Int, bytes: Long)
+    val total = scala.collection.mutable.HashMap.empty[String, Long].withDefaultValue(0L)
+    val totalNs = scala.collection.mutable.HashMap.empty[String, Long].withDefaultValue(0L)
+    var instrumentedNs = 0L
+    val per = ok map { b =>
+      Prof.reset(); Prof.on = true
+      val a0 = mx.getThreadAllocatedBytes(tid)
+      val t0 = System.nanoTime
+      airLift(b)
+      instrumentedNs += System.nanoTime - t0
+      val bytes = mx.getThreadAllocatedBytes(tid) - a0
+      Prof.on = false
+      for ((k, v) <- Prof.counts) total(k) += v
+      for ((k, v) <- Prof.nanos)  totalNs(k) += v
+      PerBoard(Prof.counts("destinations tried"), Prof.counts("destinations served"),
+               b.spaces.count(_.pieces.has(moveTypes)), bytes)
+    }
+
+    // Report
+    val n = ok.size.toDouble
+    val sorted = medians.sorted
+    def pct(p: Double) = sorted(((sorted.size - 1) * p).round.toInt)
+    println(f"boards recorded ${boards.size}%d from $g%d games; ${boards.size - ok.size}%d dropped (endless Air Lift loop); Air Lift moved something on $effective%d of ${ok.size}%d")
+    println(f"\nAir Lift time per board (median of $reps%d runs after $warmup%d warm-up rounds), microseconds:")
+    println(f"  mean ${medians.sum / n}%.0f   p10 ${pct(0.1)}%.0f   median ${pct(0.5)}%.0f   p90 ${pct(0.9)}%.0f   max ${sorted.last}%.0f")
+    println(f"  instrumented pass: ${instrumentedNs / 1e3 / n}%.0f us per Air Lift (counters and timers on)")
+    println(f"  memory allocated: ${per.map(_.bytes).sum / n / 1024}%.0f KB per Air Lift")
+    println(f"\nper Air Lift (averages over the ${ok.size}%d boards); timed phases are inclusive and nest:")
+    println(f"  ${"work"}%-58s ${"calls"}%9s ${"us total"}%9s ${"us/call"}%8s")
+    val keys = (total.keySet ++ totalNs.keySet).toList.sortBy(k => (-totalNs(k), k))
+    for (k <- keys) {
+      val calls = total(k) / n
+      if (totalNs.contains(k))
+        println(f"  $k%-58s $calls%9.1f ${totalNs(k) / 1e3 / n}%9.1f ${totalNs(k) / 1e3 / total(k)}%8.2f")
+      else
+        println(f"  $k%-58s $calls%9.1f")
+    }
+    println(f"\nspaces holding liftable pieces (US Troops, ARVN Troops, Irregulars, Rangers): ${per.map(_.liftable).sum / n}%.1f per board on average")
+    println("\ncost by destinations tried:")
+    println(f"  ${"tried"}%5s ${"boards"}%7s ${"median us"}%10s ${"served"}%7s")
+    for ((d, grp) <- (per zip medians).groupBy(_._1.dests).toList.sortBy(_._1)) {
+      val ms = grp.map(_._2).sorted
+      println(f"  $d%5d ${grp.size}%7d ${ms(ms.size / 2)}%10.0f ${grp.map(_._1.served).sum.toDouble / grp.size}%7.2f")
+    }
+  }
+}
diff --git a/src/main/scala/fitl/Autoplay.scala b/src/main/scala/fitl/Autoplay.scala
new file mode 100644
index 0000000..fec4b00
--- /dev/null
+++ b/src/main/scala/fitl/Autoplay.scala
@@ -0,0 +1,277 @@
+//  Autoplay: headless all-Bot games for calibration and experiments.
+//  Part of the Claude-FitL harness; not in the upstream program.
+//
+//  Usage: java -cp "fitl/lib/*" fitl.Autoplay --seed S --games N [--us-final-only] [--trace]
+//                                      [--us-policy FILE] [--us-player]
+//
+//  Each game is seeded: the global RNG (dice, Tru'ng deck, Bot choices) gets
+//  `seed` and the event deck is built from a separate RNG derived from it, as
+//  the Full scenario requires (piles 1964, 1965, 1965, 1968, 1968, 1968; 12
+//  events of the pile's period plus one Coup card, shuffled). The same seed
+//  always plays the same game. One JSON line per game goes to stdout; the
+//  program's own console output is discarded.
+
+package fitl
+
+import java.io.{BufferedReader, OutputStream, PrintStream, StringReader}
+import scala.util.Random
+import FireInTheLake._
+
+object Autoplay {
+  val Period1964 = List(1, 15, 17, 26, 29, 31, 43, 48, 50, 51, 55, 63, 66, 68, 75, 79, 93, 97, 101, 107, 110, 112, 116, 118)
+  val Period1965 = List(5, 6, 7, 9, 10, 14, 18, 22, 23, 24, 25, 28, 34, 38, 39, 44, 46, 47, 53, 56, 59, 64, 67, 69, 70,
+                        72, 73, 76, 78, 81, 82, 83, 85, 86, 87, 89, 90, 95, 98, 99, 100, 102, 104, 105, 106, 108, 109, 114)
+  val Period1968 = List(2, 3, 4, 8, 11, 12, 13, 16, 19, 20, 21, 27, 30, 32, 33, 35, 36, 37, 40, 41, 42, 45, 49, 52, 54,
+                        57, 58, 60, 61, 62, 65, 71, 74, 77, 80, 84, 88, 91, 92, 94, 96, 103, 111, 113, 115, 117, 119, 120)
+  val CoupCards  = (125 to 130).toList
+
+  def buildDeck(rng: Random): Vector[Int] = {
+    val ev64 = rng.shuffle(Period1964)
+    val ev65 = rng.shuffle(Period1965)
+    val ev68 = rng.shuffle(Period1968)
+    val coups = rng.shuffle(CoupCards)
+    val pileEvents = List(ev64.take(12), ev65.take(12), ev65.slice(12, 24),
+                          ev68.take(12), ev68.slice(12, 24), ev68.slice(24, 36))
+    (pileEvents zip coups).flatMap { case (evs, coup) => rng.shuffle(coup :: evs) }.toVector
+  }
+
+  //  Keeps the tail of everything the program prints, so the scripted reader
+  //  can tell which prompt it is answering.
+  class Tail extends OutputStream {
+    private val buf = new java.lang.StringBuilder
+    val rec = new java.lang.StringBuilder   // everything since rec was last cleared (--trace)
+    var recording = false
+    def write(b: Int): Unit = {
+      buf.append(b.toChar)
+      if (recording) rec.append(b.toChar)
+      if (buf.length > 8000) buf.delete(0, buf.length - 2000)
+    }
+    def text: String = buf.toString
+    def clear(): Unit = buf.setLength(0)
+  }
+
+  case class UnexpectedPrompt(prompt: String) extends RuntimeException(prompt)
+
+  //  Answers each prompt one line at a time. Console.withIn wraps this in a
+  //  BufferedReader, which asks for characters only when it needs a new line,
+  //  so every read here is the program waiting at a prompt.
+  class ScriptedReader(tail: Tail, nextCard: () => Int, full: Boolean = false, name: String = "") extends java.io.Reader {
+    private var pending = ""
+    private def answer(): String = {
+      val t = tail.text
+      val last = t.substring((t.length - 300) max 0)
+      tail.clear()
+      if (last.contains("Event card:")) nextCard().toString
+      else if (last.contains("Press Enter to continue")) ""
+      else if (last.contains("continue playing this game")) "n"
+      else if (full && t.contains("Start a new game")) "1"
+      else if (full && last.contains("Choose a scenario")) "3"
+      else if (full && last.contains("played by human players")) "0"
+      else if (full && last.contains("Enter a name for your new game")) name
+      else if (full && last.contains("Really quit")) "y"
+      else if (full && last.contains("(perform or ?)")) "perform"
+      else if (full && last.contains("(coup or ?)")) "coup"
+      else if (full && last.contains("(discard or ?)")) "discard"
+      else if (full && last.contains("(quit or ?)")) "quit"
+      else throw UnexpectedPrompt(last.trim)
+    }
+    override def read(cbuf: Array[Char], off: Int, len: Int): Int = {
+      if (pending.isEmpty) {
+        Console.out.flush()
+        pending = answer() + "\n"
+      }
+      val n = len min pending.length
+      pending.getChars(0, n, cbuf, off)
+      pending = pending.substring(n)
+      n
+    }
+    override def close(): Unit = ()
+  }
+
+  def scoreJson(scores: List[Score]): String =
+    scores.sortBy(_.faction.toString).map(s => s""""${s.faction}":${s.score}""").mkString("{", ",", "}")
+
+  //  Score components, for --trace.
+  def comps(g: GameState): Map[String, Int] = Map(
+    "sup" -> g.totalSupport, "opp" -> g.totalOpposition, "vcb" -> g.vcBasesOnMap,
+    "nvac" -> g.totalNvaControl, "nvab" -> g.nvaBasesOnMap, "coin" -> g.totalCoinControl,
+    "pat" -> g.patronage, "usav" -> g.availablelUSTroopsAndBases)
+  val CompKeys = List("sup", "opp", "vcb", "nvac", "nvab", "coin", "pat", "usav")
+  def compsJson(m: Map[String, Int], skipZero: Boolean): String =
+    CompKeys.filter(k => !skipZero || m(k) != 0).map(k => s""""$k":${m(k)}""").mkString("{", ",", "}")
+  def deltaJson(a: Map[String, Int], b: Map[String, Int]) =
+    compsJson(CompKeys.map(k => k -> (b(k) - a(k))).toMap, skipZero = true)
+  val ChooseRx = raw"(?m)^(US|ARVN|NVA|VC) chooses (.+?) (operation|special activity)".r
+  val EventRx  = raw"(?m)^(US|ARVN|NVA|VC) executes the (Unshaded|Shaded) Event".r
+
+  def runGame(seed: Long, usFinalOnly: Boolean, trace: Boolean = false): String = {
+    Random.setSeed(seed)
+    USPolicy.gameSeed = seed; USPolicy.decisions = 0
+    val deck = buildDeck(new Random(seed * 6364136223846793005L + 1442695040888963407L))
+    var cardIdx = 0
+    val tail = new Tail
+    val reader = new ScriptedReader(tail, () => { val c = deck(cardIdx); cardIdx += 1; c })
+    val out = new PrintStream(tail, false)
+    val coups = new scala.collection.mutable.ListBuffer[String]
+    var winner = ""
+    var endCoup = 0
+    var error = ""
+    val start = System.nanoTime
+    val actions = new scala.collection.mutable.ListBuffer[String]
+    var initial = ""
+
+    Console.withOut(out) {
+      Console.withIn(reader) {
+        try {
+          noEarlyWin = if (usFinalOnly) Set(US) else Set.empty
+          gameName = None
+          val scenario = scenarios("Full: 1964-1972")
+          game = initialGameState(scenario, Set.empty, false, false)
+          scenario.additionalSetup()
+          if (game.isBot(VC))
+            initAgitateTotal()
+          drawNextCard()
+          initial = compsJson(comps(game), false)
+
+          var steps = 0
+          while (!game.gameOver) {
+            steps += 1
+            if (steps > 5000) throw new IllegalStateException("step limit")
+            game = game.copy(log = Vector.empty)
+            if (game.needsCardDraw)
+              drawNextCard()
+
+            val pivot = if (eventDeck.isPivotalCard(game.currentCard)) None else getPivotalFaction
+            pivot foreach { f =>
+              game = game.copy(currentCard = f.pivotCard, pivotCardsAvailable = game.pivotCardsAvailable - f)
+            }
+
+            if (game.isCoupRound) {
+              val coupNum = game.coupCardsPlayed + 1
+              val before = game.scores
+              val c0 = comps(game)
+              val earlyWinner = before
+                .filter(e => e.score > 0)
+                .filterNot(e => noEarlyWin(e.faction))
+                .headOption
+              resolveCoupCard()
+              coups += s"""{"coup":$coupNum,"card":${game.currentCard},"victory_check":${scoreJson(before)}""" +
+                (if (trace) s""","at":${compsJson(c0, false)},"d":${deltaJson(c0, comps(game))}""" else "") + "}"
+              if (game.gameOver) {
+                endCoup = coupNum
+                winner = earlyWinner.map(_.faction.toString) getOrElse game.scores.head.faction.toString
+              }
+              else
+                game = game.copy(needsCardDraw = true)
+            }
+            else {
+              game.actingFaction match {
+                case None => game = game.copy(needsCardDraw = true)
+                case Some(f) if trace =>
+                  val c0 = comps(game)
+                  val seq0 = game.sequence
+                  val card = game.currentCard
+                  tail.rec.setLength(0); tail.recording = true
+                  try Bot.act() finally tail.recording = false
+                  val text = tail.rec.toString
+                  val act = if (game.sequence.numActors > seq0.numActors) game.sequence.actors.last.action.toString
+                            else if (game.sequence.passed(f) && !seq0.passed(f)) "Pass" else "?"
+                  val ops = ChooseRx.findAllMatchIn(text).filter(_.group(1) == f.toString).map(m => "\"" + m.group(2) + "\"").mkString(",")
+                  val ev = EventRx.findFirstMatchIn(text).filter(_.group(1) == f.toString).map(_.group(2))
+                    .getOrElse(if (text.contains("executes its Pivotal Event")) "Pivotal" else "")
+                  val pol = if (f == US && USPolicy.enabled) s""","pol":"${USPolicy.lastChoice}"""" else ""
+                  actions += s"""{"c":$card,"f":"$f","a":"$act","ev":"$ev","ops":[$ops],"d":${deltaJson(c0, comps(game))}$pol}"""
+                  if (game.sequence.exhausted)
+                    game = game.copy(needsCardDraw = true)
+                case Some(_) =>
+                  Bot.act()
+                  if (game.sequence.exhausted)
+                    game = game.copy(needsCardDraw = true)
+              }
+            }
+          }
+        }
+        catch {
+          case UnexpectedPrompt(p) => error = "prompt: " + p.replace("\n", " ").takeRight(160)
+          case e: Throwable        => error = e.getClass.getSimpleName + ": " + String.valueOf(e.getMessage).take(160)
+        }
+      }
+    }
+
+    val secs = (System.nanoTime - start) / 1e9
+    def q(s: String) = "\"" + s.replace("\\", "\\\\").replace("\"", "'") + "\""
+    val finalScores = if (game != null) scoreJson(game.scores) else "{}"
+    val cards = if (game != null) game.cardsSeen.size else 0
+    s"""{"seed":$seed,"us_final_only":$usFinalOnly,"winner":${q(winner)},"end_coup":$endCoup,""" +
+    s""""final_coup":${endCoup == 6},"cards":$cards,"coups_played":${if (game != null) game.coupCardsPlayed else 0},"final_scores":$finalScores,""" +
+    s""""coups":${coups.mkString("[", ",", "]")},""" +
+    (if (trace) s""""initial":$initial,"actions":${actions.mkString("[", ",", "]")},""" else "") +
+    s""""secs":${"%.2f".format(secs)},"error":${q(error)}}"""
+  }
+
+  //  Validation: the program's own interactive main loop, every prompt answered
+  //  by script, same seed and deck. Saves go to ./games, so run it in a
+  //  scratch directory. Returns cards drawn, Coups played and final scores.
+  def runViaMain(seed: Long): String = {
+    def rmrf(f: java.io.File): Unit = {
+      if (f.isDirectory) Option(f.listFiles).toList.flatten foreach rmrf
+      f.delete()
+    }
+    rmrf(new java.io.File("games"))
+    Random.setSeed(seed)
+    val deck = buildDeck(new Random(seed * 6364136223846793005L + 1442695040888963407L))
+    var cardIdx = 0
+    val tail = new Tail
+    val reader = new ScriptedReader(tail, () => { val c = deck(cardIdx); cardIdx += 1; c }, full = true, name = s"Auto$seed")
+    var error = ""
+    Console.withOut(new PrintStream(tail, false)) {
+      Console.withIn(reader) {
+        try FireInTheLake.main(Array.empty)
+        catch {
+          case UnexpectedPrompt(p) => error = "prompt: " + p.replace("\n", " ").takeRight(160)
+          case e: Throwable        => error = e.getClass.getSimpleName + ": " + String.valueOf(e.getMessage).take(160)
+        }
+      }
+    }
+    s"""{"seed":$seed,"mode":"main","cards":${game.cardsSeen.size},"coups_played":${game.coupCardsPlayed},""" +
+    s""""final_scores":${scoreJson(game.scores)},"error":"${error.replace("\"", "'")}"}"""
+  }
+
+  def main(args: Array[String]): Unit = {
+    def arg(name: String, default: String) = {
+      val i = args.indexOf(name)
+      if (i >= 0 && i + 1 < args.length) args(i + 1) else default
+    }
+    val seed  = arg("--seed", "1").toLong
+    val games = arg("--games", "1").toInt
+    val usFinalOnly = args.contains("--us-final-only")
+    val viaMain = args.contains("--via-main")
+    val trace = args.contains("--trace")
+    //  --us-player: both parts. --track-arvn / --vc-sees-player: one part each.
+    usIsPlayer  = args.contains("--us-player") || args.contains("--vc-sees-player")
+    arvnTracked = args.contains("--us-player") || args.contains("--track-arvn")
+    val policy = arg("--us-policy", "")
+    if (policy.nonEmpty)
+      USPolicy.load(policy)
+    val timeoutSecs = arg("--timeout", "10").toInt
+    for (i <- 0 until games) {
+      //  Watchdog: some seeds send the program's Bots into a loop that does
+      //  not end. A JVM thread cannot be stopped, so on a timeout report the
+      //  seed and exit; the batch driver restarts at the next seed.
+      val s = seed + i
+      val watchdog = new Thread(() => {
+        try {
+          Thread.sleep(timeoutSecs * 1000L)
+          System.out.println(s"""{"seed":$s,"us_final_only":$usFinalOnly,"error":"timeout ${timeoutSecs}s"}""")
+          System.out.flush()
+          Runtime.getRuntime.halt(3)
+        } catch { case _: InterruptedException => }
+      })
+      watchdog.setDaemon(true)
+      watchdog.start()
+      println(if (viaMain) runViaMain(s) else runGame(s, usFinalOnly, trace))
+      System.out.flush()
+      watchdog.interrupt()
+    }
+  }
+}
diff --git a/src/main/scala/fitl/Bot.scala b/src/main/scala/fitl/Bot.scala
index f0952bb..717688f 100644
--- a/src/main/scala/fitl/Bot.scala
+++ b/src/main/scala/fitl/Bot.scala
@@ -51,6 +51,15 @@ object Bot {
   // Value to indicate that space selection is unlimited.
   val NO_LIMIT = 1000;
 
+  //  Harness (USPolicy): a work limit for trial actions. Some games send the
+  //  Bot's move planning (Air Lift) into a loop that does not end; a trial
+  //  that uses up its work is abandoned with WorkExceeded. Work is counted in
+  //  keep-rule evaluations (every move planner step makes one), not in time,
+  //  so the cut-off is the same on every machine and under any load.
+  case class WorkExceeded() extends RuntimeException("work limit exceeded")
+  var workLeft = Long.MaxValue
+  def checkWork(): Unit = { workLeft -= 1; if (workLeft < 0) throw WorkExceeded() }
+
   // These values are used with HighestScore and LowestScore filters
   // when a candidate is not qualified to produce a score.
   // For example if it is a LoC and we are only considering
@@ -202,7 +211,7 @@ object Bot {
     def compare(diceValue: Int, targetValue: Int): Boolean = diceValue >= targetValue
   }
   
-  def logCheck(result: Boolean, display: String): Boolean = {
+  def logCheck(result: Boolean, display: => String): Boolean = {
     if (game.logTrung || game.botDebug) {
       val yesNo = if (result) "[Yes]" else "[No]"
       log(s"Trung check: $display $yesNo")
@@ -402,7 +411,9 @@ object Bot {
     val sp             = game.getSpace(name)
     val maxShift       = ((maxSupport.value - sp.support.value) max 0) min maxLevels
     val maxInSpace     = maxShift + sp.terror
-    val d3Limit        = if (coupRound) NO_LIMIT else d3
+    //  Harness: like the activation roll, the d3 cap stands in for untracked
+    //  ARVN Resources; a US paying tracked Resources is not capped.
+    val d3Limit        = if (coupRound || (arvnTracked && faction == US)) NO_LIMIT else d3
     val availResources = if (faction == ARVN) game.arvnResources else ((game.arvnResources - game.econ) max 0)
     val maxAfford      = (coupRound, useResources) match {
       case (_, true)  if cost == 0 => NO_LIMIT
@@ -846,13 +857,14 @@ object Bot {
