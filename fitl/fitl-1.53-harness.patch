diff --git a/src/main/scala/fitl/Lookahead.scala b/src/main/scala/fitl/Lookahead.scala
new file mode 100644
index 0000000..b6e38d7
--- /dev/null
+++ b/src/main/scala/fitl/Lookahead.scala
@@ -0,0 +1,150 @@
+//  Lookahead: score a US candidate action by playing the game forward.
+//  Part of the Claude-FitL harness; not in the upstream program.
+//
+//  From the position after the candidate (its trial), the game is played on
+//  with every faction as a Bot (the US by its Tru'ng routines, so the search
+//  does not call itself) until the Victory check of the next Coup, or to the
+//  end of the game in the final campaign. Only public information is used:
+//  the event cards still to come are drawn as the deck's piles allow given
+//  the cards seen, and the Bots' Tru'ng decks are reshuffled. Each candidate
+//  is played forward on the same set of seeds (common random numbers).
+//
+//  A playout's value, survival first:
+//    a Bot over its line at the Victory check (the game would end): -100
+//    the check passed: the US lead (US margin minus the best rival's)
+//    the final Coup: the US lead, plus 100 if the US wins
+//  A playout that fails (a program assertion, a Bot loop) is left out.
+
+package fitl
+
+import java.io.{OutputStream, PrintStream}
+import scala.util.Random
+import FireInTheLake._
+
+object Lookahead {
+  var inRollout = false
+  //  FITL_ROLLOUT_SEARCH=1: in playouts the US plays by its search policy
+  //  (without look-ahead) instead of its Tru'ng routines.
+  var searchInRollout = sys.env.contains("FITL_ROLLOUT_SEARCH")
+  val Debug = sys.env.contains("FITL_LA_DEBUG")
+  val LossValue = -100.0
+  val WinBonus  = 100.0
+  val RolloutWork = 2000000L          // keep-rule evaluations per playout (the Bots' loop bug)
+
+  object Stats {
+    val on = sys.env.contains("FITL_LA_STATS")
+    var decisions = 0L; var rollouts = 0L; var failed = 0L; var nanos = 0L; var changed = 0L
+    if (on) Runtime.getRuntime.addShutdownHook(new Thread(() => {
+      System.err.println(f"Lookahead: $decisions decisions, ${rollouts.toDouble / (decisions max 1)}%.1f playouts and " +
+        f"${nanos / 1e6 / (decisions max 1)}%.0f ms each (${nanos.toDouble / (rollouts max 1) / 1e6}%.1f ms a playout), " +
+        f"$failed failed; the look-ahead changed the choice in $changed")
+    }))
+  }
+
+  private val sink = new PrintStream(new OutputStream { def write(b: Int): Unit = () })
+
+  def lead(scores: List[Score]): Double = {
+    val m = scores.map(s => s.faction -> s.score).toMap
+    (m(US) - (m(ARVN) max m(NVA) max m(VC))).toDouble
+  }
+
+  //  One playout from `start` (US action done and recorded); None if it failed.
+  //  reseed: before each step (a faction's turn, a card draw, a Coup round)
+  //  the dice are reset from the seed, the cards seen, the actors so far and
+  //  the faction to act,
+  //  so two playouts on one seed from different positions roll the same dice
+  //  at the same point of the game, however many each used before.
+  def playout(start: GameState, seed: Long, horizonCoups: Int, reseed: Boolean = false): Option[Double] = {
+    val savedGame = game
+    val savedWork = Bot.workLeft
+    var result: Option[Double] = None
+    inRollout = true
+    try {
+      Bot.testOutcome {
+        Random.setSeed(seed)
+        game = start.copy(trungDeck = new Random(seed * 13 + 5).shuffle(start.trungDeck))
+        Bot.workLeft = RolloutWork
+        val tail   = new Autoplay.Tail
+        val reader = new Autoplay.ScriptedReader(tail, Branch.deckFrom(game.cardsSeen, new Random(seed * 31 + 7)))
+        Console.withOut(new PrintStream(tail, false)) {
+          Console.withIn(reader) {
+            var coups = 0
+            var steps = 0
+            while (result.isEmpty && !game.gameOver) {
+              steps += 1
+              if (steps > 3000) throw new IllegalStateException("playout step limit")
+              game = game.copy(log = Vector.empty)
+              if (reseed)
+                Random.setSeed(seed * 0x9E3779B97F4A7C15L + 1000003L * game.cardsSeen.size +
+                               7919L * game.sequence.numActors + (if (game.needsCardDraw) 17L else 0L) +
+                               31L * game.actingFaction.map(_.toString.hashCode.toLong).getOrElse(0L))
+              if (game.needsCardDraw)
+                drawNextCard()
+              val pivot = if (eventDeck.isPivotalCard(game.currentCard)) None else getPivotalFaction
+              pivot foreach { f =>
+                game = game.copy(currentCard = f.pivotCard, pivotCardsAvailable = game.pivotCardsAvailable - f)
+              }
+              if (game.isCoupRound) {
+                val before = game.scores
+                val final_ = game.isFinalCampaign
+                if (before.exists(s => s.faction != US && s.score > 0))
+                  result = Some(LossValue)
+                else if (!final_ && coups + 1 >= horizonCoups)
+                  result = Some(lead(before))
+                else {
+                  resolveCoupCard()
+                  coups += 1
+                  if (final_ || game.gameOver) {
+                    val win = game.scores.head.faction == US
+                    result = Some(lead(game.scores) + (if (win) WinBonus else 0.0))
+                  }
+                  else
+                    game = game.copy(needsCardDraw = true)
+                }
+              }
+              else game.actingFaction match {
+                case None => game = game.copy(needsCardDraw = true)
+                case Some(_) =>
+                  Bot.act()
+                  if (game.sequence.exhausted)
+                    game = game.copy(needsCardDraw = true)
+              }
+            }
+          }
+        }
+      }
+    }
+    catch { case e: Throwable =>
+      result = None
+      if (Debug && Stats.failed < 3) { System.err.println(s"playout failed: $e"); e.printStackTrace(System.err) }
+    }
+    finally { inRollout = false; Bot.workLeft = savedWork; game = savedGame }
+    if (result.isEmpty) Stats.failed += 1
+    Stats.rollouts += 1
+    result
+  }
+
+  //  The position after the US action, as Bot.act would leave it.
+  def afterAction(g: GameState, action: Action): GameState = {
+    val seq = g.sequence.addActor(US, action)
+    g.copy(sequence = seq, needsCardDraw = g.needsCardDraw || seq.exhausted)
+  }
+
+  //  Mean playout value of each position, on common seeds: `rollouts` each,
+  //  then 2 x `rollouts` more for the best two (their mean over all of them).
+  def values(positions: List[(String, GameState)], rollouts: Int, seed: Long, horizonCoups: Int): Map[String, Double] = {
+    val got = scala.collection.mutable.Map.empty[String, Vector[Double]].withDefaultValue(Vector.empty)
+    def more(name: String, pos: GameState, from: Int, until: Int): Unit =
+      got(name) = got(name) ++ (from until until).flatMap(r => playout(pos, seed + 104729L * r, horizonCoups))
+    def mean(name: String) = if (got(name).isEmpty) Double.NegativeInfinity else got(name).sum / got(name).size
+    positions foreach { case (n, p) => more(n, p, 0, rollouts) }
+    if (positions.size > 2)
+      positions.sortBy(np => -mean(np._1)).take(2) foreach { case (n, p) => more(n, p, rollouts, 3 * rollouts) }
+    if (Debug) positions foreach { case (n, _) =>
+      val vs = got(n); val m = mean(n)
+      val sd = if (vs.size > 1) math.sqrt(vs.map(v => (v - m) * (v - m)).sum / (vs.size - 1)) else 0.0
+      System.err.println(f"  LA card ${game.currentCard}%3d seen ${game.cardsSeen.size}%2d  $n%-36s mean $m%7.2f sd $sd%6.2f losses ${vs.count(_ <= LossValue + 50)}/${vs.size}")
+    }
+    positions.map { case (n, _) => n -> mean(n) }.toMap
+  }
+}
diff --git a/src/main/scala/fitl/Prof.scala b/src/main/scala/fitl/Prof.scala
new file mode 100644
index 0000000..6e68e39
--- /dev/null
+++ b/src/main/scala/fitl/Prof.scala
@@ -0,0 +1,18 @@
+//  Prof: counters and phase timers for measuring the Bots' movement planner.
+//  Part of the Claude-FitL harness; not in the upstream program.
+//  Off unless `Prof.on` is set (only fitl.AirLiftBench does), when every hook
+//  is a single boolean test.
+
+package fitl
+
+object Prof {
+  var on = false
+  val counts = scala.collection.mutable.HashMap.empty[String, Long].withDefaultValue(0L)
+  val nanos  = scala.collection.mutable.HashMap.empty[String, Long].withDefaultValue(0L)
+
+  def count(key: String, n: Long = 1): Unit = if (on) counts(key) += n
+  //  Add the time since `t0` (a System.nanoTime value) to `key`, and count one call.
+  def done(key: String, t0: Long): Unit = if (on) { nanos(key) += System.nanoTime - t0; counts(key) += 1 }
+  def start(): Long = if (on) System.nanoTime else 0L
+  def reset(): Unit = { counts.clear(); nanos.clear() }
+}
