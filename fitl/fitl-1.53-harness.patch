+//  USPolicy: a tunable decision layer for the US Bot.
+//  Part of the Claude-FitL harness; not in the upstream program.
+//
+//  When a policy is loaded (Autoplay --us-policy FILE), Bot.act() asks this
+//  object for the US action instead of the Tru'ng US cards. Everything is
+//  still carried out by the program's own US Bot routines, so the rules are
+//  the program's.
+//
+//  Modes:
+//    trung   the Tru'ng US cards, through this hook (a regression check: the
+//            games must be identical to having no policy at all).
+//    search  one-ply search. Build candidate actions (Event, Pass, each US
+//            Operation with each Special Activity it may take, Limited Op,
+//            and each with a space "focus" put in front of the US Bot's own
+//            space priorities), try each on a copy of the game with fresh
+//            dice, score the result with a weighted sum of features, and
+//            carry out the best one on dice not used by any trial. A trial
+//            that throws, or uses more than trial_work keep-rule evaluations
+//            (the program's Air Lift planning can loop forever), is discarded.
+//
+//  Policy file (JSON), every field optional:
+//    {"mode": "search", "samples": 2, "trial_work": 5000, "commit_plan": true, "hinge_buffer": 3,
+//     "focuses": ["default", "opposition", "vc", "nva", "population"],
+//     "weights": {"us": 1.0, "vc": -1.0, ...}}
+//  Weights not given keep the defaults below. The score of a candidate is
+//  sum(weight * feature); see `features` for the feature names.
+
+package fitl
+
+import scala.util.Random
+import FireInTheLake._
+import Bot._
+
+object USPolicy {
+
+  case class Config(
+    mode: String,
+    samples: Int,
+    trialWork: Long,
+    commitPlan: Boolean,
+    hingeBuffer: Double,
+    explore: Double,
+    lookahead: Int,          // playouts per shortlisted candidate (0: the weighted score alone)
+    laCandidates: Int,       // candidates shortlisted by the weighted score for the look-ahead
+    laCoups: Int,            // play forward to the Victory check of this many Coups ahead
+    focuses: List[String],
+    weights: Map[String, Double])
+
+  var config: Option[Config] = None
+  def enabled = config.nonEmpty
+
+  //  For --trace: the last US decision, as "<candidate> <value> <n candidates>".
+  var lastChoice = ""
+
+  //  FITL_POLICY_DEBUG set: print the features at each US decision to stderr.
+  val Debug = sys.env.contains("FITL_POLICY_DEBUG")
+
+  //  FITL_POLICY_DESIGN=PREFIX: at each US decision append one JSON line to
+  //  PREFIX.<pid> with the features before the decision and, for every
+  //  candidate, its value and the features (with Pass/Event extras) after
+  //  its first trial. For studying how the features rank candidates.
+  lazy val designLog: Option[java.io.PrintWriter] = sys.env.get("FITL_POLICY_DESIGN") map { p =>
+    new java.io.PrintWriter(new java.io.FileWriter(s"$p.${ProcessHandle.current.pid}", true))
+  }
+  //  FITL_POLICY_REPLAY=PREFIX: at each US decision append one JSON line to
+  //  PREFIX.<pid> comparing the chosen candidate's trial with the real run:
+  //  the space/piece picks of each (random tie-breaks marked "1 of N") and
+  //  the score each reached.
+  lazy val replayLog: Option[java.io.PrintWriter] = sys.env.get("FITL_POLICY_REPLAY") map { p =>
+    new java.io.PrintWriter(new java.io.FileWriter(s"$p.${ProcessHandle.current.pid}", true))
+  }
+  //  FITL_POLICY_FIT=PREFIX: after each US decision is carried out, append
+  //  one JSON line to PREFIX.<pid> with the game's seed, the decision's
+  //  number in the game, the action, the features of the board before it
+  //  ("b") and of the board it left ("f", with Pass/Event extras).
+  //  tools/botfit.py fits weights to these.
+  lazy val fitLog: Option[java.io.PrintWriter] = sys.env.get("FITL_POLICY_FIT") map { p =>
+    new java.io.PrintWriter(new java.io.FileWriter(s"$p.${ProcessHandle.current.pid}", true))
+  }
+  //  Set by Autoplay at the start of each game, for the fit log.
+  var gameSeed  = 0L
+  var decisions = 0
+  private def jstr(x: String) = "\"" + x.replace("\\", "\\\\").replace("\"", "'") + "\""
+  private def jsonMap(m: Map[String, Double]) =
+    m.toList.sortBy(_._1).map { case (k, v) => f""""$k":$v%.4f""" }.mkString("{", ",", "}")
+
+  val DefaultWeights: Map[String, Double] = Map(
+    "us"                    ->  1.0,
+    "arvn"                  -> -0.3,
+    "nva"                   -> -0.6,
+    "vc"                    -> -1.0,
+    "max_rival"             -> -0.5,
+    "rival_hinge"           -> -1.5,
+    "rival_hinge_coup_next" -> -2.0,
+    "vc_guerrillas"         -> -0.3,
+    "vc_underground"        -> -0.1,
+    "nva_troops"            -> -0.1,
+    "nva_guerrillas"        -> -0.1,
+    "us_casualties"         -> -0.3,
+    "arvn_res"              ->  0.03,
+    "aid"                   ->  0.02,
+    "trail"                 -> -0.5,
+    "terror"                -> -0.3,
+    "pass"                  ->  1.0,
+    "event"                 ->  0.0,
+    "event_critical"        ->  1.0,
+    "event_performed"       ->  0.5,
+    //  Added after the first tuning run. Their defaults are 0 so that older
+    //  policy files play exactly as before; policies/tune2-start.json sets them.
+    "tet_live"              ->  0.0,
+    "tet_near"              ->  0.0,
+    "easter_live"           ->  0.0,
+    "easter_near"           ->  0.0,
+    "agitate_exposure"      ->  0.0,
+    "rival_hinge_coup_soon" ->  0.0,
+    //  Added with --us-player (ARVN Resources tracked). Default 0 as above.
+    "arvn_spendable"        ->  0.0,
+    "arvn_spendable_capped" ->  0.0,
+    //  Added with USPlayer: US position on the map. Default 0 as above.
+    "us_troops_map"         ->  0.0,
+    "us_assault_potential"  ->  0.0,
+    "support_exposed"       ->  0.0
+  )
+
+  val DefaultTrialWork = 5000L
+
+  val ConfigKeys = Set("mode", "samples", "trial_work", "commit_plan", "hinge_buffer", "explore", "lookahead", "la_candidates", "la_coups", "focuses", "weights", "name")
+
+  def load(path: String): Unit = {
+    val text = new String(java.nio.file.Files.readAllBytes(java.nio.file.Paths.get(path)), "UTF-8")
+    val m = Json.parse(text).asInstanceOf[Map[String, Any]]
+    def num(x: Any): Double = x match {
+      case i: Int        => i.toDouble
+      case l: Long       => l.toDouble
+      case b: BigDecimal => b.toDouble
+      case other         => throw new IllegalArgumentException(s"$path: not a number: $other")
+    }
+    val unknown = m.keySet -- ConfigKeys
+    if (unknown.nonEmpty)
+      throw new IllegalArgumentException(s"$path: unknown keys: ${unknown.mkString(", ")}")
+    val w = m.get("weights").map(_.asInstanceOf[Map[String, Any]].map { case (k, v) => k -> num(v) }).getOrElse(Map.empty)
+    //  "x@t" and "x@c" are phase weights for feature x (see `phase`).
+    val badW = w.keySet.map(_.stripSuffix("@t").stripSuffix("@c")) -- DefaultWeights.keySet
+    if (badW.nonEmpty)
+      throw new IllegalArgumentException(s"$path: unknown weights: ${badW.mkString(", ")}")
+    val focuses = m.get("focuses").map(_.asInstanceOf[Seq[Any]].map(_.toString).toList).getOrElse(Focuses.keys.toList.sorted)
+    val badF = focuses.toSet -- Focuses.keySet
+    if (badF.nonEmpty)
+      throw new IllegalArgumentException(s"$path: unknown focuses: ${badF.mkString(", ")}")
+    val mode = m.getOrElse("mode", "search").toString
+    if (mode != "search" && mode != "trung")
+      throw new IllegalArgumentException(s"$path: mode must be search or trung")
+    config = Some(Config(
+      mode        = mode,
+      samples     = m.get("samples").map(num(_).toInt).getOrElse(2) max 1,
+      trialWork   = m.get("trial_work").map(num(_).toLong).getOrElse(DefaultTrialWork),
+      commitPlan  = m.get("commit_plan").exists(_ == true),
+      hingeBuffer = m.get("hinge_buffer").map(num).getOrElse(3.0),
+      explore     = m.get("explore").map(num).getOrElse(0.0),
+      lookahead   = m.get("lookahead").map(num(_).toInt).getOrElse(0),
+      laCandidates = m.get("la_candidates").map(num(_).toInt).getOrElse(5),
+      laCoups     = m.get("la_coups").map(num(_).toInt).getOrElse(1),
+      focuses     = focuses,
+      weights     = DefaultWeights ++ w))
+  }
+
+  // ---------------------------------------------------------------
+  //  Space focuses: priorities put in front of the US Bot's own, by kind.
+  // ---------------------------------------------------------------
+  private def score(desc: String)(f: Space => Int) = new HighestScore[Space](desc, f)
+  private def allKinds(p: PriorityFilter[Space]) =
+    List("support", "place", "sweep", "airlift", "airstrike", "remove").map(_ -> List(p)).toMap
+
+  val Focuses: Map[String, Map[String, List[PriorityFilter[Space]]]] = Map(
+    "default"    -> Map.empty,
+    "opposition" -> {
+      val opp = score("Most Opposition")(sp => if (sp.isLoC) NO_SCORE else sp.oppositionValue)
+      Map("support" -> List(opp), "place" -> List(opp), "sweep" -> List(opp), "airlift" -> List(opp), "remove" -> List(opp))
+    },
+    "vc"         -> allKinds(score("Most VC")(sp => 3 * sp.pieces.totalOf(VCBases) + sp.pieces.totalOf(VCGuerrillas))),
+    "nva"        -> allKinds(score("Most NVA")(sp => 3 * sp.pieces.totalOf(NVABases) + sp.pieces.totalOf(NVATroops) +
+                                                     sp.pieces.totalOf(NVAGuerrillas))),
+    "population" -> {
+      val pop = score("Most Population")(sp => if (sp.isLoC) NO_SCORE else sp.population)
+      Map("support" -> List(pop), "place" -> List(pop), "sweep" -> List(pop))
+    }
+  )
+
+  // ---------------------------------------------------------------
+  //  Evaluation
+  // ---------------------------------------------------------------
+  //  Probability that a Coup card is among the `h` cards after the on-deck
+  //  card, from public information: each pile of `cardsPerCampaign` cards
+  //  holds one Coup, and the cards drawn so far (current and on-deck
+  //  included) are known.
+  def coupSoon(g: GameState, h: Int): Double = {
+    val size  = g.cardsPerCampaign
+    val seen  = g.cardsSeen
+    val piles = g.totalCoupCards
+    val positions = (seen.size until seen.size + h).filter(_ / size < piles)
+    val noCoup = positions.groupBy(_ / size).map { case (pile, pos) =>
+      val revealed = seen.slice(pile * size, (pile + 1) * size)
+      if (revealed exists (c => eventDeck(c).isCoup)) 1.0
+      else 1.0 - pos.size.toDouble / (size - revealed.size)
+    }.product
+    1.0 - noCoup
+  }
+
+  //  What VC could gain by Agitation at the next Coup: in the 4 best spaces
+  //  with VC pieces, no COIN Control and not at Active Opposition, the
+  //  population times the levels it could shift (up to 2).
+  def agitateExposure(g: GameState): Double = {
+    val gains = g.nonLocSpaces collect {
+      case sp if sp.population > 0 && sp.pieces.has(VCPieces) && !sp.coinControlled &&
+                 sp.support != ActiveOpposition =>
+        sp.population * ((sp.support.value - ActiveOpposition.value) min 2)
+    }
+    gains.sorted(Ordering[Int].reverse).take(4).sum.toDouble
+  }
+
+  def features(g: GameState, hingeBuffer: Double): Map[String, Double] = {
+    val s        = g.scores.map(x => x.faction -> x.score.toDouble).toMap
+    val rivals   = List(s(ARVN), s(NVA), s(VC))
+    val hinge    = rivals.map(r => (r + hingeBuffer) max 0.0).sum
+    val coupNext = g.onDeckCard != 0 && eventDeck(g.onDeckCard).isCoup
+    def onMap(types: Iterable[PieceType]) = g.totalOnMap(_.pieces.totalOf(types)).toDouble
+    val leaders     = g.numCardsInLeaderBox >= 2
+    val tetAvail    = g.pivotCardsAvailable(VC)
+    val easterAvail = g.pivotCardsAvailable(NVA)
+    val vcSouth     = g.spaces.filter(sp => isInSouthVietnam(sp.name)).map(_.pieces.totalOf(VCGuerrillas)).sum
+    val nvaTroops   = g.totalOnMap(_.pieces.totalOf(NVATroops))
+    val usTroops    = g.totalOnMap(_.pieces.totalOf(USTroops))
+    val spendable   = ((g.arvnResources - g.econ) max 0).toDouble
+    //  Enemy pieces a US Assault could remove where US Troops now stand
+    //  (firepower against vulnerable NVA/VC pieces, by the program's rules).
+    val assaultPotential = g.spaces.iterator.filter(sp => !sp.isNorthVietnam && sp.pieces.has(USTroops)).map { sp =>
+      val enemy = sp.pieces.only(NVAPieces) + sp.pieces.only(VCPieces)
+      coinFirepower(NormalTroops)(sp) min vulnerableInsurgents(enemy, false, false).total
+    }.sum.toDouble
+    //  Support that Terror or Agitation can reach: population times Support
+    //  levels in spaces holding NVA or VC Guerrillas.
+    val supportExposed = g.spaces.iterator.filter(_.pieces.has(Guerrillas)).map(_.supportValue).sum.toDouble
+    Map(
+      "us"                    -> s(US),
+      "arvn"                  -> s(ARVN),
+      "nva"                   -> s(NVA),
+      "vc"                    -> s(VC),
+      "max_rival"             -> rivals.max,
+      "rival_hinge"           -> hinge,
+      "rival_hinge_coup_next" -> (if (coupNext) hinge else 0.0),
+      "vc_guerrillas"         -> onMap(VCGuerrillas),
+      "vc_underground"        -> onMap(List(VCGuerrillas_U)),
+      "nva_troops"            -> onMap(List(NVATroops)),
+      "nva_guerrillas"        -> onMap(NVAGuerrillas),
+      "us_casualties"         -> g.casualties.totalOf(USPieces).toDouble,
+      "arvn_res"              -> g.arvnResources.toDouble,
+      "aid"                   -> g.usAid.toDouble,
+      "trail"                 -> g.trail.toDouble,
+      "terror"                -> g.totalOnMap(_.terror).toDouble,
+      //  Pivotal denial: Tet needs 2+ Leader cards and >20 VC Guerrillas in
+      //  the South; Easter Offensive needs 2+ Leader cards and more NVA
+      //  Troops than US Troops on the map. *_live: playable now; *_near: how
+      //  close (0 until 4 short, capped at 8). Both 0 once the card is gone.
+      "tet_live"              -> (if (tetAvail && leaders && vcSouth > 20) 1.0 else 0.0),
+      "tet_near"              -> (if (tetAvail) ((vcSouth - 16) max 0 min 8).toDouble else 0.0),
+      "easter_live"           -> (if (easterAvail && leaders && nvaTroops > usTroops) 1.0 else 0.0),
+      "easter_near"           -> (if (easterAvail) ((nvaTroops - usTroops + 4) max 0 min 8).toDouble else 0.0),
+      "agitate_exposure"      -> agitateExposure(g),
+      "rival_hinge_coup_soon" -> coupSoon(g, 2) * hinge,
+      //  ARVN Resources the US may spend (above Econ), and the same capped at
+      //  9 (three Pacify levels) so the tuner can make its value level off.
+      //  Constant unless ARVN Resources are tracked (--us-player).
+      "arvn_spendable"        -> spendable,
+      "arvn_spendable_capped" -> (spendable min 9.0),
+      "us_troops_map"         -> usTroops.toDouble,
+      "us_assault_potential"  -> assaultPotential,
+      "support_exposed"       -> supportExposed
+    )
+  }
+
+  //  The stage of the game, for phase weights: t is the share of the deck
+  //  seen so far (current and on-deck cards included), c the chance of a
+  //  Coup among the next 2 cards (public information, see coupSoon). Both
+  //  are the same for every candidate of a decision. With phase weights
+  //  the weight of feature x is w(x) + t * w(x@t) + c * w(x@c).
+  def phase(g: GameState): (Double, Double) =
+    (g.cardsSeen.size.toDouble / (g.cardsPerCampaign * g.totalCoupCards), coupSoon(g, 2))
+
+  def value(cfg: Config, g: GameState, extra: Map[String, Double]): Double = {
+    val f = features(g, cfg.hingeBuffer) ++ extra
+    if (!cfg.weights.keys.exists(_.contains('@')))
+      f.iterator.map { case (k, v) => cfg.weights.getOrElse(k, 0.0) * v }.sum
+    else {
+      val (t, c) = phase(g)
+      f.iterator.map { case (k, v) =>
+        (cfg.weights.getOrElse(k, 0.0) + t * cfg.weights.getOrElse(k + "@t", 0.0) + c * cfg.weights.getOrElse(k + "@c", 0.0)) * v
+      }.sum
+    }
+  }
+
+  // ---------------------------------------------------------------
+  //  Candidates
+  // ---------------------------------------------------------------
+  //  run() carries the candidate out on the current game and returns the
+  //  action taken, or None if it could not be carried out.
+  case class Candidate(name: String, run: () => Option[Action])
+
+  val SpecialsFor = Map(
+    "Train"   -> List("Advise", "AirLift", "AirStrike"),
+    "Patrol"  -> List("Advise", "AirLift", "AirStrike"),
+    "Sweep"   -> List("AirLift", "AirStrike"),
+    "Assault" -> List("AirLift", "AirStrike"))
+
+  def runOp(op: String, sa: Option[String], action: Action, focus: String, first: Boolean,
+            arvnCap: Int = NO_LIMIT): Option[Action] = {
+    US_Bot.focus = Focuses(focus)
+    US_Bot.arvnPlacementCap = arvnCap
+    try {
+      val params = Params(addSpecialActivity = sa.nonEmpty, maxSpaces = if (action == LimitedOp) Some(1) else None)
+      def doSA(): Boolean = sa match {
+        case Some("Advise")    => US_Bot.adviseActivity(params)
+        case Some("AirLift")   => US_Bot.airLiftActivity(params)
+        case Some("AirStrike") => US_Bot.airStrikeActivity(params)
+        case _                 => false
+      }
+      //  Same order as the Tru'ng US cards: Train takes its Special Activity
+      //  first, Assault during, Patrol and Sweep after.
+      val (opDone, saDone) = op match {
+        case "Train"   => val d = doSA(); (US_Bot.trainOp(params, 3).nonEmpty, d)
+        case "Patrol"  => val o = US_Bot.patrolOp(params).nonEmpty; (o, o && doSA())
+        case "Sweep"   => val o = US_Bot.sweepOp(params).nonEmpty; (o, o && doSA())
+        case "Assault" => US_Bot.assaultOp(params)(() => doSA()) match {
+          case Some((_, d)) => (true, d)
+          case None         => (false, false)
+        }
+      }
+      if (!opDone) None
+      else Some(if (action == OpPlusSpecial && !saDone && first) OpOnly else action)
+    }
+    finally { US_Bot.focus = Map.empty; US_Bot.arvnPlacementCap = NO_LIMIT }
+  }
+
+  def candidates(cfg: Config, card: EventCard): List[Candidate] = {
+    val seq   = game.sequence
+    val first = seq.numActors == 0
+    val list  = new scala.collection.mutable.ListBuffer[Candidate]
+    list += Candidate("Pass", () => { factionPasses(US); Some(Pass) })
+    if (seq.canDo(Event) && !card.isCoup && card.eventEffective(US))
+      list += Candidate("Event", () => { executeEvent(US, card); Some(Event) })
+    //  With tracked ARVN Resources, Train is also offered with at most 1 or 2
+    //  ARVN placements, so the search can keep Resources for Pacify.
+    val trainCaps = if (arvnTracked) List(1, 2, NO_LIMIT) else List(NO_LIMIT)
+    for (focus <- cfg.focuses; op <- List("Train", "Patrol", "Sweep", "Assault");
+         cap <- (if (op == "Train") trainCaps else List(NO_LIMIT))) {
+      val tag  = if (focus == "default") "" else s" @$focus"
+      val name = if (cap == NO_LIMIT) op else s"$op[arvn<=$cap]"
+      if (seq.canDo(OpPlusSpecial)) {
+        for (sa <- SpecialsFor(op))
+          list += Candidate(s"$name+$sa$tag", () => runOp(op, Some(sa), OpPlusSpecial, focus, first, cap))
+        if (!seq.canDo(OpOnly))
+          list += Candidate(s"$name$tag", () => runOp(op, None, OpPlusSpecial, focus, first, cap))
+      }
+      if (seq.canDo(OpOnly))
+        list += Candidate(s"$name only$tag", () => runOp(op, None, OpOnly, focus, first, cap))
+      if (seq.canDo(LimitedOp) && cap == NO_LIMIT)
+        list += Candidate(s"$op LimOp$tag", () => runOp(op, None, LimitedOp, focus, first))
+    }
+    list.toList
+  }
+
+  def extras(a: Action, card: EventCard): Map[String, Double] = a match {
+    case Pass  => Map("pass" -> 1.0)
+    case Event => Map("event" -> 1.0,
+                      "event_critical"  -> (if (card.isCritical(US)) 1.0 else 0.0),
+                      "event_performed" -> (if (card.isPerformed(US)) 1.0 else 0.0))
+    case _     => Map.empty
+  }
+
+  // ---------------------------------------------------------------
+  //  The decision
+  // ---------------------------------------------------------------
+  def act(card: EventCard): Action = {
+    val cfg = config.get
+    if (cfg.mode == "trung" || (Lookahead.inRollout && !Lookahead.searchInRollout))
+      trungAction(US, card)
+    else
+      search(cfg, card)
+  }
+
+  //  FITL_TRIAL_TIMES=1: time every trial, grouped by the kind of candidate
+  //  (Operation, Special Activity, Op only / LimOp; focus and Train cap are
+  //  folded in), and the whole search per decision. Printed at exit.
+  object TrialTimes {
+    val on = sys.env.contains("FITL_TRIAL_TIMES")
+    val n  = scala.collection.mutable.Map.empty[String, Long].withDefaultValue(0L)
+    val ns = scala.collection.mutable.Map.empty[String, Long].withDefaultValue(0L)
+    var decisions = 0L
+    var searchNs  = 0L
+    def kind(name: String) = name.split(" @").head.replaceAll("""\[arvn<=\d\]""", "")
+    def add(name: String, t: Long): Unit = { val k = kind(name); n(k) += 1; ns(k) += t }
+    if (on) Runtime.getRuntime.addShutdownHook(new Thread(() => {
+      val total = ns.values.sum
+      System.err.println(f"trials: ${n.values.sum}%d in $decisions%d US decisions, ${total / 1e9}%.2f s in trials, ${searchNs / 1e9}%.2f s in the whole search")
+      System.err.println(f"  ${"candidate kind"}%-20s ${"trials"}%8s ${"per decision"}%13s ${"us each"}%8s ${"share"}%7s")
+      for (k <- ns.keys.toList.sortBy(k => -ns(k)))
+        System.err.println(f"  $k%-20s ${n(k)}%8d ${n(k).toDouble / decisions}%13.1f ${ns(k) / 1e3 / n(k)}%8.0f ${100.0 * ns(k) / total}%6.1f%%")
+    }))
+  }
+
+  //  FITL_WORK_STATS: the distribution of work (keep-rule evaluations) per trial, at exit.
+  object WorkStats {
+    val on = sys.env.contains("FITL_WORK_STATS")
+    val used = scala.collection.mutable.ArrayBuffer.empty[Long]
+    var cut = 0
+    var maxDone = 0L
+    def add(w: Long, limit: Long): Unit = if (on) { used += w; if (w > limit) cut += 1 else maxDone = maxDone max w }
+    if (on) Runtime.getRuntime.addShutdownHook(new Thread(() => {
+      val xs = used.sorted
+      def q(p: Double) = if (xs.isEmpty) 0L else xs(((xs.size - 1) * p).toInt)
+      System.err.println(s"work per trial: ${xs.size} trials, mean ${if (xs.isEmpty) 0 else xs.sum / xs.size}, " +
+        s"p50 ${q(0.5)}, p99 ${q(0.99)}, p99.9 ${q(0.999)}, p99.99 ${q(0.9999)}, largest finished $maxDone, cut off $cut")
+    }))
+  }
+
+  //  The fit log line for one decision (also used by USPlayer).
+  def logFit(cfg: Config, before: Map[String, Double], chosen: String, explored: Boolean, done: Option[Action],
+             card: EventCard, kind: String = "turn"): Unit = {
+    decisions += 1
+    fitLog foreach { w =>
+      val (t, c) = phase(game)
+      w.println(s"""{"seed":$gameSeed,"i":$decisions,"kind":"$kind","card":${game.currentCard},"seen":${game.cardsSeen.size},""" +
+                f""""t":$t%.4f,"c":$c%.4f,""" +
+                s""""chosen":${jstr(chosen)},"explored":$explored,"done":${jstr(done.map(_.toString).getOrElse("None"))},""" +
+                s""""b":${jsonMap(before)},"f":${jsonMap(features(game, cfg.hingeBuffer) ++ done.map(extras(_, card)).getOrElse(Map.empty))}}""")
+      w.flush()
+    }
+  }
+
+  def search(cfg: Config, card: EventCard): Action = {
+    val searchT0 = if (TrialTimes.on) System.nanoTime else 0L
+    AirLiftBench.record(game)
+    val base  = Random.nextLong()
+    val saved = game
+    if (Debug)
+      System.err.println(s"card ${game.currentCard} seen ${game.cardsSeen.size} leaders ${game.numCardsInLeaderBox} " +
+        features(game, cfg.hingeBuffer).toList.sortBy(_._1).map { case (k, v) => f"$k=$v%.2f" }.mkString(" "))
+    val cands = candidates(cfg, card)
+    val before = if (fitLog.nonEmpty) features(game, cfg.hingeBuffer) else Map.empty[String, Double]
+    //  Work left on entry (a playout's own budget when searching inside one).
+    val workSaved = workLeft
+
+    //  Each candidate is tried on the same `samples` dice streams (common
+    //  random numbers), none of which is the stream the real action uses.
+    //  With commit_plan, the first trial's space and piece choices (its
+    //  tie-breaks) are the candidate's plan: later trials and the real action
+    //  replay them, so only the dice differ.
+    val trialPicks = scala.collection.mutable.Map.empty[String, List[String]]
+    val post       = scala.collection.mutable.Map.empty[String, GameState]   // after each candidate's first trial
+    val plans      = scala.collection.mutable.Map.empty[String, List[(List[String], String)]]
+    def startReplay(name: String): Unit = if (cfg.commitPlan) {
+      planReplay = plans.getOrElse(name, Nil); planReplaying = true; planDiverged = false
+    }
+    def stopPlan(): Unit = { planRecord = None; planReplay = Nil; planReplaying = false }
+    val trials = cands flatMap { c =>
+      val runs = (1 to cfg.samples) flatMap { k =>
+        val t0 = if (TrialTimes.on) System.nanoTime else 0L
+        Random.setSeed(base + 7919L * k)
+        workLeft = cfg.trialWork
+        if (replayLog.nonEmpty && k == 1) pickLog = Some(new scala.collection.mutable.ListBuffer[String])
+        val record = new scala.collection.mutable.ListBuffer[(List[String], String)]
+        if (cfg.commitPlan) { if (k == 1) planRecord = Some(record) else startReplay(c.name) }
+        try testOutcome {
+          initTurnVariables()
+          c.run() map (a => (value(cfg, game, extras(a, card)) +
+                               { if (k == 1 && (cfg.lookahead > 0 || Teacher.on)) post(c.name) = Lookahead.afterAction(game, a); 0.0 },
+                             if (designLog.nonEmpty) features(game, cfg.hingeBuffer) ++ extras(a, card) else Map.empty[String, Double]))
+        }
+        catch { case _: Throwable => None }
+        finally {
+          game = saved; WorkStats.add(cfg.trialWork - workLeft, cfg.trialWork); workLeft = workSaved
+          pickLog foreach (l => trialPicks(c.name) = l.toList)
+          pickLog = None
+          if (cfg.commitPlan && k == 1) plans(c.name) = record.toList
+          stopPlan()
+          if (TrialTimes.on) TrialTimes.add(c.name, System.nanoTime - t0)
+        }
+      }
+      if (runs.isEmpty) None else Some((c, runs.map(_._1).sum / runs.size, runs.head._2))
+    }
+    val scored0 = trials map { case (c, v, _) => c -> v }
+    if (Teacher.on && !Lookahead.inRollout)
+      Teacher.consider(cfg, saved, scored0, post.toMap, base)
+    //  Look-ahead: the best few by the weighted score are played forward and
+    //  ranked by their playouts (see Lookahead); the rest cannot be chosen.
+    val scored = if (cfg.lookahead <= 0 || scored0.size < 2 || Lookahead.inRollout) scored0 else {
+      val t0 = System.nanoTime
+      //  The best `la_candidates` distinct positions (many candidates differ
+      //  only in a space focus that changed nothing).
+      val short = scored0.sortBy(-_._2).filter(cv => post.contains(cv._1.name))
+        .foldLeft(List.empty[(Candidate, Double)]) { (acc, cv) =>
+          if (acc.size >= cfg.laCandidates || acc.exists(a => post(a._1.name) == post(cv._1.name))) acc else acc :+ cv
+        }
+      val la = Lookahead.values(short.map(cv => cv._1.name -> post(cv._1.name)), cfg.lookahead,
+                                base ^ 0x6A09E667F3BCC909L, cfg.laCoups)
+      Lookahead.Stats.decisions += 1
+      Lookahead.Stats.nanos += System.nanoTime - t0
+      if (short.nonEmpty && short.maxBy(cv => la(cv._1.name))._1 != scored0.maxBy(_._2)._1) Lookahead.Stats.changed += 1
+      scored0 map { case (c, v) => c -> la.getOrElse(c.name, Double.NegativeInfinity) }
+    }
+
+    val (top, topValue) = scored.maxBy(_._2)
+    //  explore > 0: with that probability carry out a candidate chosen at
+    //  random instead of the best, so that the fit log also covers choices
+    //  the weights would not make. Drawn from its own RNG: the game's dice
+    //  are not touched.
+    val explorer = new Random(base ^ 0x5DEECE66DL)
+    val explored = cfg.explore > 0 && explorer.nextDouble() < cfg.explore
+    val (best, bestValue) = if (explored) scored(explorer.nextInt(scored.size)) else (top, topValue)
+    designLog foreach { w =>
+      val cs = trials map { case (c, v, f) => f"""{"name":"${c.name}","v":$v%.4f,"f":${jsonMap(f)}}""" }
+      w.println(s"""{"card":${game.currentCard},"seen":${game.cardsSeen.size},"first":${game.sequence.numActors == 0},""" +
+                s""""chosen":"${best.name}","before":${jsonMap(features(game, cfg.hingeBuffer))},"cands":${cs.mkString("[", ",", "]")}}""")
+      w.flush()
+    }
+    if (TrialTimes.on) { TrialTimes.decisions += 1; TrialTimes.searchNs += System.nanoTime - searchT0 }
+    lastChoice = f"${best.name} $bestValue%.2f ${scored.size}" + (if (explored) " explore" else "")
+    log(f"\nUS policy chooses: ${best.name} (value $bestValue%.2f, ${if (explored) "explored, " else ""}best of ${scored.size} candidates)")
+
+    Random.setSeed(base)
+    initTurnVariables()
+    workLeft = cfg.trialWork
+    if (replayLog.nonEmpty) pickLog = Some(new scala.collection.mutable.ListBuffer[String])
+    startReplay(best.name)
+    val result = try best.run() catch { case _: Throwable => None } finally workLeft = workSaved
+    val diverged = cfg.commitPlan && planDiverged
+    stopPlan()
+    val realPicks = pickLog.map(_.toList).getOrElse(Nil)
+    pickLog = None
+    replayLog foreach { w =>
+      val realValue = result map (a => f"${value(cfg, game, extras(a, card))}%.4f") getOrElse "null"
+      w.println(s"""{"card":${game.currentCard},"chosen":${jstr(best.name)},"trial_value":${f"$bestValue%.4f"},""" +
+                s""""real_value":$realValue,"trial_picks":${trialPicks.getOrElse(best.name, Nil).map(jstr).mkString("[", ",", "]")},""" +
+                s""""real_picks":${realPicks.map(jstr).mkString("[", ",", "]")},"diverged":$diverged}""")
+      w.flush()
+    }
+    val done = result getOrElse {
+      // Could not be carried out on these dice: undo anything done and pass.
+      game = saved
+      initTurnVariables()
+      lastChoice += " -> Pass"
+      factionPasses(US)
+      Pass
+    }
+    decisions += 1
+    fitLog foreach { w =>
+      val (t, c) = phase(game)
+      w.println(s"""{"seed":$gameSeed,"i":$decisions,"card":${game.currentCard},"seen":${game.cardsSeen.size},""" +
+                f""""t":$t%.4f,"c":$c%.4f,""" +
+                s""""chosen":${jstr(best.name)},"explored":$explored,"done":${jstr(done.toString)},""" +
+                s""""b":${jsonMap(before)},"f":${jsonMap(features(game, cfg.hingeBuffer) ++ extras(done, card))}}""")
+      w.flush()
+    }
+    done
+  }
+}
