+//  Prof: counters and phase timers for measuring the Bots' movement planner.
+//  Part of the Claude-FitL harness; not in the upstream program.
+//  Off unless `Prof.on` is set (only fitl.AirLiftBench does), when every hook
+//  is a single boolean test.
+
+package fitl
+
+object Prof {
+  var on = false
+  val counts = scala.collection.mutable.HashMap.empty[String, Long].withDefaultValue(0L)
+  val nanos  = scala.collection.mutable.HashMap.empty[String, Long].withDefaultValue(0L)
+
+  def count(key: String, n: Long = 1): Unit = if (on) counts(key) += n
+  //  Add the time since `t0` (a System.nanoTime value) to `key`, and count one call.
+  def done(key: String, t0: Long): Unit = if (on) { nanos(key) += System.nanoTime - t0; counts(key) += 1 }
+  def start(): Long = if (on) System.nanoTime else 0L
+  def reset(): Unit = { counts.clear(); nanos.clear() }
+}
